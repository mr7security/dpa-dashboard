[Unit]
Description=Dashboard de Bases de Datos (SolarWinds DPA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dashboard-dpa
Group=dashboard-dpa
WorkingDirectory=/opt/dashboard-dpa
ExecStart=/usr/bin/python3 /opt/dashboard-dpa/dpa.py
Restart=always
RestartSec=10
SyslogIdentifier=dashboard-dpa

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/dashboard-dpa

[Install]
WantedBy=multi-user.target
